# ==================================================
# DLC Dev Stack v1.2.1-alpha - Environment Variables
# ==================================================

# Common
NODE_ENV=development

# API Configuration (Backend - tools/apps/dlc-dev-api)
API_PORT=30089

# MySQL 8 – Game Databases (Last Chaos Architecture)
DB_AUTH_HOST=127.0.0.1
DB_AUTH_PORT=3306
DB_AUTH_USER=root
DB_AUTH_PASS=root
DB_AUTH_NAME=db_auth

DB_GAME_HOST=127.0.0.1
DB_GAME_PORT=3306
DB_GAME_USER=root
DB_GAME_PASS=root
DB_GAME_NAME=db_db

DB_DATA_HOST=127.0.0.1
DB_DATA_PORT=3306
DB_DATA_USER=root
DB_DATA_PASS=root
DB_DATA_NAME=db_data

DB_POST_HOST=127.0.0.1
DB_POST_PORT=3306
DB_POST_USER=root
DB_POST_PASS=root
DB_POST_NAME=db_post

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:33440

# Security (MUST be set before production)
JWT_SECRET=replace-this-before-prod
JWT_EXPIRES_IN=86400
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Redis Cache
USE_CACHE=false
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
CACHE_TTL=120
CACHE_PREFIX=dlc

# Application Settings
SWAGGER_ENABLED=true
APP_VERSION=1.2.1-alpha
PRELOAD_ON_START=false
PRELOAD_TABLES=t_item,t_skill,t_skilllevel,t_string
LOG_LEVEL=debug

# Web Frontend Configuration (tools/apps/dlc-dev-web)
NEXT_PUBLIC_API_URL=http://localhost:30089
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=1.2.1-alpha
WEB_PORT=33440

# Docker Compose (for production deployment)
MYSQL_ROOT_PASSWORD=root
DB_USER=root
DB_PASSWORD=root
ADMINER_PORT=8080
