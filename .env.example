# ========================================================
# EVS-DLC — Environment Example (v1.2.3-alpha)
# ========================================================

# Common
NODE_ENV=development
APP_VERSION=1.2.3-alpha
LOG_LEVEL=debug

# API
API_PORT=30089
CORS_ORIGIN=http://localhost:33440

# MySQL 8 — Core Schemas
DB_AUTH_HOST=127.0.0.1
DB_AUTH_PORT=3306
DB_AUTH_USER=root
DB_AUTH_PASS=root
DB_AUTH_NAME=db_auth

DB_GAME_HOST=127.0.0.1
DB_GAME_PORT=3306
DB_GAME_USER=root
DB_GAME_PASS=root
DB_GAME_NAME=db_db

DB_DATA_HOST=127.0.0.1
DB_DATA_PORT=3306
DB_DATA_USER=root
DB_DATA_PASS=root
DB_DATA_NAME=db_data

# MySQL 8 — Ops/Workflow (NEU)
DB_OPS_HOST=127.0.0.1
DB_OPS_PORT=3306
DB_OPS_USER=root
DB_OPS_PASS=root
DB_OPS_NAME=db_ops

# Security
JWT_SECRET=replace-this-before-prod
JWT_EXPIRES_IN=86400
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Optional
USE_CACHE=false
REDIS_URL=redis://localhost:6379
CACHE_TTL=120
CACHE_PREFIX=dlc
SWAGGER_ENABLED=false
PRELOAD_ON_START=false
PRELOAD_TABLES=t_item,t_skill,t_skilllevel,t_string
