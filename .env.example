# ==================================================
# DLC Dev Stack v1.0.0-alpha - Environment Variables
# ==================================================

# Common
NODE_ENV=development

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DATABASE=dlc_main

# API Configuration (Backend - tools/apps/dlc-dev-api)
API_PORT=30089

# Multiple Database Connections (Legacy Support)
DB_AUTH_HOST=localhost
DB_AUTH_PORT=3306
DB_AUTH_USER=root
DB_AUTH_PASS=secret
DB_AUTH_NAME=db_auth

DB_GAME_HOST=localhost
DB_GAME_PORT=3306
DB_GAME_USER=root
DB_GAME_PASS=secret
DB_GAME_NAME=db_game

DB_DATA_HOST=localhost
DB_DATA_PORT=3306
DB_DATA_USER=root
DB_DATA_PASS=secret
DB_DATA_NAME=db_data

DB_POST_HOST=localhost
DB_POST_PORT=3306
DB_POST_USER=root
DB_POST_PASS=secret
DB_POST_NAME=db_post

# Security (MUST be set before production)
JWT_SECRET=replace-this-before-prod
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000

# Redis Cache
USE_CACHE=false
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
CACHE_TTL=120
CACHE_PREFIX=dlc

# Application Settings
SWAGGER_ENABLED=true
APP_VERSION=1.0.0-alpha
PRELOAD_ON_START=false
PRELOAD_TABLES=t_item,t_skill,t_skilllevel,t_string
LOG_LEVEL=debug

# Web Frontend Configuration (tools/apps/dlc-dev-web)
NEXT_PUBLIC_API_URL=http://localhost:30089
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0-alpha
WEB_PORT=3000

# Docker Compose (for production deployment)
MYSQL_ROOT_PASSWORD=secret
DB_USER=root
DB_PASSWORD=secret
ADMINER_PORT=8080
